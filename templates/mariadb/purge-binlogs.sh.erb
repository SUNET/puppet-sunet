#!/bin/bash

if docker exec -t mariadb-db-1 sh -c 'command -v mariadb' &>/dev/null; then
    CMD="mariadb"
else
    CMD="mysql"
fi
x_hours_ago=$(date -d "<%= @binlog_retention_hours %> hours ago" "+%Y-%m-%d %H:%M:%S")
docker exec mariadb-db-1 "${CMD}" -u root -p'<%= @mariadb_root_password %>' -N -B -e "PURGE BINARY LOGS BEFORE '${x_hours_ago}'"
