services:

  db:
    image: <%= @mariadb_image %>:<%= @mariadb_version %>
    restart: always
    volumes:
      - /opt/mariadb/backups:/backups
      - /opt/mariadb/conf:/etc/mysql/mariadb.conf.d
      - /opt/mariadb/datadir:/var/lib/mysql
      - /opt/mariadb/init:/docker-entrypoint-initdb.d
      - /opt/mariadb/scripts:/scripts
<%- if @use_tls -%>
      - /opt/mariadb/cert:/etc/mysql/ssl:ro
      - <%= @ca_cert_path %>:<%= @ca_cert_path%>:ro
<% end -%>
<%- if @backup -%>
      - /opt/mariadb_backup/start_replica_from_init.sh:/start_replica_from_init.sh
<% end -%>
<%- if @galera -%>
    network_mode: host
<% end -%>
<%- if !@dns.empty? -%>
    dns:
<% @dns.each do |resolver| -%>
      - '<%= resolver %>'
<% end -%>
<%- end -%>
    environment:
      - MYSQL_ROOT_PASSWORD=<%= @mariadb_root_password %>
<%- if @mariadb_user -%>
      - MYSQL_USER=<%= @mariadb_user %>
<%- end -%>
<%- if @mariadb_user_password -%>
      - MYSQL_PASSWORD=<%= @mariadb_user_password %>
<%- end -%>
<%- if @mariadb_database -%>
      - MYSQL_DATABASE=<%= @mariadb_database %>
<%- end -%>
<%- if @galera -%>
<%- if @new_cluster -%>
    command:  "--wsrep-new-cluster"
    tty: true
<% else -%>
    tty: true
<%- end -%>
<%- end -%>
<%- if @docker_healthcheck -%>
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      start_period: 10s
      interval: 10s
      timeout: 5s
      retries: 3
<%- end -%>