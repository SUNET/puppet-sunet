#!/bin/bash

VALKEY_PORT=6379
FQDN=$(hostname --fqdn)
INFRA_CERT_PATH="/opt/valkey/cert/cert.pem"
INFRA_KEY_PATH="/opt/valkey/cert/privkey.pem"
CA_CERT_PATH=<%= @ca_cert_path %>


# Function to display usage
function usage() {
  echo "Usage: $0 <command>"
  echo ""
  echo "Commands:"
  echo "  --connect          Open an interactive Valkey CLI session"
  echo "  --ping             Send a PING to verify connectivity"
  echo "  --server-info      Show server information"
  echo "  --client-info      Show connected clients information"
  echo "  --cluster-nodes    Show all cluster nodes and their state"
  echo "  --cluster-info     Show cluster health summary"
  echo "  --list-keys        Scan and list keys"
  echo "  --stats            Show server statistics"
  echo "  --info-memory      Show memory usage information"
  echo "  --latency          Show latency metrics and diagnostics"
  echo "  --config-rewrite   Rewrite the server config to disk"
  echo "  --custom-command   Run a custom Valkey command (e.g. --custom-command 'GET mykey')"
  exit 1
}

function get_valkey_password() {
  # Get the valkey password stored in eyaml
  local valkey_password=$(eyaml decrypt -f /etc/hiera/data/local.eyaml --pkcs7-private-key=/etc/hiera/eyaml/private_key.pkcs7.pem --pkcs7-public-key=/etc/hiera/eyaml/public_certkey.pkcs7.pem | awk '/^valkey_password: /{print $2}')
  echo "$valkey_password"
}

function connect() {
  local valkey_password=$(get_valkey_password)
  <%= @cli_client %> -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT"
}

function ping() {
  local valkey_password=$(get_valkey_password)
  <%= @cli_client %> -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" PING
}

function server_info() {
  local valkey_password=$(get_valkey_password)
  <%= @cli_client %> -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" INFO SERVER
}

function cluster_nodes() {
  local valkey_password=$(get_valkey_password)
  <%= @cli_client %> -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" CLUSTER NODES
}

function cluster_info() {
  local valkey_password=$(get_valkey_password)
  <%= @cli_client %> -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" CLUSTER INFO
}

function list_keys() {
  local valkey_password=$(get_valkey_password)
  <%= @cli_client %> -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" SCAN 0
}

function stats() {
  local valkey_password=$(get_valkey_password)
  <%= @cli_client %> -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" INFO STATS
}

function client_info() {
  local valkey_password=$(get_valkey_password)
  <%= @cli_client %> -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" INFO CLIENTS
}

function info_memory() {
  local valkey_password=$(get_valkey_password)
  <%= @cli_client %> -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" INFO MEMORY
}

function latency() {
  local valkey_password=$(get_valkey_password)
  <%= @cli_client %> -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" LATENCY LATEST
  <%= @cli_client %> -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" LATENCY DOCTOR
}

function config_rewrite() {
  local valkey_password=$(get_valkey_password)
  <%= @cli_client %> -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" CONFIG REWRITE
}

function custom_command() {
  local command="$1"
  local valkey_password=$(get_valkey_password)

  <%= @cli_client %> -a "$valkey_password" \
    --no-auth-warning \
    -h "$FQDN" \
    --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" \
    -p "$VALKEY_PORT" \
    $command
}

# Parse the options
OPTIONS=$(getopt -o '' --long connect,ping,server-info,client-info,cluster-nodes,cluster-info,list-keys,stats,info-memory,latency,config-rewrite,custom-command: -- "$@")
if [ $? -ne 0 ]; then
  usage
fi

# Ensure at least one option was provided
if [ $# -eq 0 ]; then
  usage
fi

# Evaluate the parsed options
eval set -- "$OPTIONS"
while true; do
  case "$1" in
    --connect)
      connect
      shift
      break
      ;;
    --ping)
      ping
      shift
      break
      ;;
    --server-info)
      server_info
      shift
      break
      ;;
    --client-info)
      client_info
      shift
      break
      ;;
    --cluster-nodes)
      cluster_nodes
      shift
      break
      ;;
    --cluster-info)
      cluster_info
      shift
      break
      ;;
    --list-keys)
      list_keys
      shift
      break
      ;;
    --stats)
      stats
      shift
      break
      ;;
    --info-memory)
      info_memory
      shift
      break
      ;;
    --latency)
      latency
      shift
      break
      ;;
    --config-rewrite)
      config_rewrite
      shift
      break
      ;;
    --custom-command)
      custom_command "$2"
      shift 2
      break
      ;;
    --)
      shift
      break
      ;;
    *)
      usage
      ;;
  esac
done

exit 0
