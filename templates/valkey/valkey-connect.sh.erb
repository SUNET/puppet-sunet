#!/bin/bash

VALKEY_PORT=6379
FQDN=$(hostname --fqdn)
INFRA_CERT_PATH="/opt/valkey/cert/cert.pem"
INFRA_KEY_PATH="/opt/valkey/cert/privkey.pem"
CA_CERT_PATH=<%= @ca_cert_path %>


# Function to display usage
function usage() {
  echo "Usage: $0 --connect | --ping | --server-info | --client-info | --cluster-nodes | --cluster-info | --list-keys | --stats | --latency"
  exit 1
}

function get_valkey_password() {
  # Get the valkey password stored in eyaml
  local valkey_password=$(eyaml decrypt -f /etc/hiera/data/local.eyaml --pkcs7-private-key=/etc/hiera/eyaml/private_key.pkcs7.pem --pkcs7-public-key=/etc/hiera/eyaml/public_certkey.pkcs7.pem | awk '/^valkey_password: /{print $2}')
  echo "$valkey_password"
}

function connect() {
  local valkey_password=$(get_valkey_password)
  redis-cli -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT"
}

function ping() {
  local valkey_password=$(get_valkey_password)
  redis-cli -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" PING
}

function server_info() {
  local valkey_password=$(get_valkey_password)
  redis-cli -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" INFO SERVER
}

function cluster_nodes() {
  local valkey_password=$(get_valkey_password)
  redis-cli -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" CLUSTER NODES
}

function cluster_info() {
  local valkey_password=$(get_valkey_password)
  redis-cli -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" CLUSTER INFO
}

function list_keys() {
  local valkey_password=$(get_valkey_password)
  redis-cli -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" SCAN 0
}

function stats() {
  local valkey_password=$(get_valkey_password)
  redis-cli -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" INFO STATS
}

function client_info() {
  local valkey_password=$(get_valkey_password)
  redis-cli -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" INFO CLIENTS
}

function memory_info() {
  local valkey_password=$(get_valkey_password)
  redis-cli -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" INFO MEMORY
}

function latency() {
  local valkey_password=$(get_valkey_password)
  redis-cli -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" LATENCY LATEST
  redis-cli -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" LATENCY DOCTOR
}

function _test() {
  local valkey_password=$(get_valkey_password)
  redis-cli -a "$valkey_password" --no-auth-warning -h $FQDN --tls --cert "$INFRA_CERT_PATH" --key "$INFRA_KEY_PATH" --cacert "$CA_CERT_PATH" -p "$VALKEY_PORT" INFO MEMORY
}

# Parse the options
OPTIONS=$(getopt -o '' --long connect,ping,server-info,client-info,cluster-nodes,cluster-info,list-keys,stats,memory-info,latency,test -- "$@")
if [ $? -ne 0 ]; then
  usage
fi

# Check if exactly one option was provided
if [ $# -ne 1 ]; then
  usage
fi

# Evaluate the parsed options
eval set -- "$OPTIONS"
while true; do
  case "$1" in
    --connect)
      connect
      shift
      break
      ;;
    --ping)
      ping
      shift
      break
      ;;
    --server-info)
      server_info
      shift
      break
      ;;
    --client-info)
      client_info
      shift
      break
      ;;
    --cluster-nodes)
      cluster_nodes
      shift
      break
      ;;
    --cluster-info)
      cluster_info
      shift
      break
      ;;
    --list-keys)
      list_keys
      shift
      break
      ;;
    --stats)
      stats
      shift
      break
      ;;
    --memory-info)
      memory_info
      shift
      break
      ;;
    --latency)
      latency
      shift
      break
      ;;
    --test)
      _test
      shift
      break
      ;;
    --)
      shift
      break
      ;;
    *)
      usage
      ;;
  esac
done

exit 0
