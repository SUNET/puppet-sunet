#!/usr/bin/env bash

set -e

echo "Checking valkey cluster status, please standby..."
cluster_status=$(redis-cli -a "$(puppet lookup --render-as s valkey_password 2>/dev/null)" --tls --cert /opt/valkey/cert/cert.pem --key /opt/valkey/cert/privkey.pem --cacert <%= @ca_cert_path %> -h $(hostname -f) cluster nodes 2> /dev/null)

my_ip=$(echo "${cluster_status}" | grep myself, | awk '{print $2}' | cut -d : -f 1)

masters_on_host=$(echo "${cluster_status}" | grep "${my_ip}" | grep -c master)

if [ "${masters_on_host}" -gt 1 ]; then
	echo "WARNING! This machine is master for multiple shards! Maybe do a failover before reboot?" | cowsay
else
	echo "Valkey cluster is ready for reboot"
fi
