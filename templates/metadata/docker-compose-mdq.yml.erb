version: '3.2'

services:
  mdq:
    hostname: <%= @hostname %>
    image: docker.sunet.se/swamid/mdq-publisher:<%= @imagetag %>
    volumes:
      - '/var/www/html:/var/www/html'
<% if @acme -%>
      - '/opt/mdq_publisher/certs:/certs:ro'
<% else -%>
      - '/etc/dehydrated:/etc/dehydrated'
      - '/etc/ssl:/etc/ssl'
<% end -%>
    environment:
<%- @env.each do |env| -%>
      - "<%= env %>"
<%- end -%>
<%- @env_certs.each do |env| -%>
      - "<%= env %>"
<%- end -%>
    ports:
      - "443:443"
