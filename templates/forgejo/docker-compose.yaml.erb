version: "3.7"

services:
  forgejo:
    init: true
    container_name: forgejo
    restart: always
    user: "<%= @uid %>:<%= @gid %>"
    image: codeberg.org/forgejo/forgejo:<%= @forgejo_version %>
    dns:
      - 89.32.32.32
    ports:
      - "3000:3000"
      - "22022:22022"
    volumes:
      - /opt/forgejo/backups:/opt/forgejo/backups
      - /opt/forgejo/config:/opt/forgejo/config
      - /opt/forgejo/data:/opt/forgejo/data
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    networks:
      - internal_network
      - external_network
    environment:
      - USER=git
      - UID=<%= @uid %>
      - GID=<%= @gid %>
      - HOME=/data/git
      - GITEA_WORK_DIR=/opt/forgejo/data
    entrypoint: gitea -c /opt/forgejo/config/app.ini
  # Challenges browsers on the archive download endpoints (and serves its own
  # assets under /.within.website/); everything else goes straight to forgejo.
  anubis:
    image: ghcr.io/techarohq/anubis:<%= @anubis_version %>
    container_name: anubis
    restart: always
    user: "<%= @uid %>:<%= @gid %>"
    networks:
      - internal_network
    volumes:
      - /opt/forgejo/anubis/botPolicy.yaml:/etc/anubis/botPolicy.yaml:ro
      - /opt/forgejo/anubis/state:/data/state
    environment:
      - BIND=:8923
      - TARGET=http://forgejo:3000
      - POLICY_FNAME=/etc/anubis/botPolicy.yaml
      - SERVE_ROBOTS_TXT=false
  caddy:
    image: docker.io/library/caddy:2
    container_name: caddy
    networks:
      - internal_network
      - external_network
    dns:
      - 89.32.32.32
    ports:
      - "443:443"
    volumes:
      - /opt/forgejo/Caddyfile:/etc/caddy/Caddyfile:ro
      - /opt/forgejo/caddy/data:/data
      - /opt/forgejo/caddy/config:/config
    restart: unless-stopped
networks:
  external_network:
  internal_network:
    internal: true
