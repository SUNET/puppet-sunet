#!/bin/sh
# script created by Puppet (sunet::etcd::node)

common_args="--endpoints <%= @advertise_client_urls[0] %>"
args="$common_args                 \
  --key <%= @key_file %>           \
  --cacert <%= @trusted_ca_file %> \
  --cert <%= @cert_file %>"


exec docker exec -it etcd \
  /usr/local/bin/etcdctl  \
  $args                   \
  $*
