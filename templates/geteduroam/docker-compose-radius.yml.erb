services:
  radius:
    image: docker.sunet.se/geteduroam-freeradius:<%= @freeradius_tag %>
<% unless @resolvers.empty? -%>
    dns:
<% @resolvers.each do |resolver| -%>
      - <%= resolver %>
<% end -%>
<% end -%>
    ports:
      - 1812:1812/udp
    command: -f -l stdout
    volumes:
      - "/opt/geteduroam/cert:/etc/freeradius/certs:ro"
      - "/opt/geteduroam/config/radiusd.conf:/etc/freeradius/radiusd.conf:ro"
      - "/opt/geteduroam/config/clients.conf:/etc/freeradius/clients.conf:ro"
      - "/opt/geteduroam/config/eap.conf:/etc/freeradius/mods-enabled/eap:ro"
      - "/opt/geteduroam/config/spoof-check.conf:/etc/freeradius/sites-enabled/spoof-check:ro"
      - "/opt/geteduroam/config/geteduroam.conf:/etc/freeradius/sites-enabled/geteduroam:ro"

<% if @ocsp %>
  ocsp:
    image: docker.sunet.se/geteduroam-ocsp:<%= @ocsp_tag %>
    environment:
      - SQLHOST=haproxy
      - SQLUSER=geteduroam
      - SQLDB=geteduroam
      - SQLPASSWORD=<%= scope.call_function('safe_hiera', ['mariadb_user_password'])  %>
<% end %>

  haproxy:
    image: haproxy:<%= @haproxy_tag %>
    ports:
      - 3306:3306
    volumes:
      - "/opt/geteduroam/haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg"
