module(load="imudp")

input(
  type="imudp"
  port="<%= @udp_port %>"
  ruleset="rs-from-udp"
)

ruleset(name="rs-from-udp") {
  action(
    type="omfile"
    dynaFile="tmpl_dynfile"
  )
<% @graylog_servers.each do |server| -%>
  action(
    type="omfwd"
    target="<%= server.split(':')[0] %>"
    port="<%= server.split(':')[1] %>"
    protocol="udp"
    template="tmpl_gelf"
  )
<% end -%>
}
