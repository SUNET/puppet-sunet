version: "3.7"

services:
  caddy:
    image: docker.io/library/caddy:2
    container_name: caddy
    networks:
      - internal_network
      - external_network
    dns:
      - 89.32.32.32
    ports:
      - "443:443"
    volumes:
      - /opt/mastodon_web/Caddyfile:/etc/caddy/Caddyfile:ro
      - /opt/mastodon_web/caddy/data:/data
      - /opt/mastodon_web/caddy/config:/config
    restart: unless-stopped

  web:
    image: <%= @mastodon_image %>:<%= @mastodon_version %>
    container_name: web
    restart: unless-stopped
    env_file:
      - mastodon.env
    command: bash -c "rm -f /mastodon/tmp/pids/server.pid; bundle exec rails s -p 3000"
    networks:
      - external_network
      - internal_network
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider --proxy=off localhost:3000/health || exit 1"]
    ports:
      - "127.0.0.1:3000:3000"
    dns:
      - 89.32.32.32
    volumes:
      - /opt/mastodon_web/mastodon:/mastodon/public/system
    environment:
      - ES_ENABLED=false

  streaming:
    container_name: streaming
    image: <%= @streaming_image %>:<%= @streaming_version %>
    restart: unless-stopped
    env_file: mastodon.env
    command: node ./streaming
    dns:
      - 89.32.32.32
    networks:
      - external_network
      - internal_network
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider --proxy=off localhost:4000/api/v1/streaming/health || exit 1"]
    ports:
      - "127.0.0.1:4000:4000"

  sidekiq:
    container_name: sidekiq
    image: <%= @mastodon_image %>:<%= @mastodon_version %>
    restart: unless-stopped
    env_file: mastodon.env
    command: bundle exec sidekiq
    dns:
      - 89.32.32.32
    networks:
      - external_network
      - internal_network
    volumes:
      - /opt/mastodon_web/mastodon:/mastodon/public/system
    extra_hosts:
      <%= @smtp_server %>: <%= @smtp_ip %>

  files:
    container_name: files
    image: nginx:latest
    restart: unless-stopped
    dns:
      - 89.32.32.32
    networks:
      - external_network
      - internal_network
    volumes:
      - /opt/mastodon_web/files-nginx-vhost.conf:/etc/nginx/conf.d/default.conf:ro
      - /opt/mastodon_web/files-nginx-www-root:/var/www/html:ro

networks:
  external_network:
  internal_network:
    internal: true
