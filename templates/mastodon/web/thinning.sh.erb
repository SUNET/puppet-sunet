#!/usr/bin/env bash

set -e

/usr/local/bin/tootctl media remove --days <%= @thinning_days_media %>          --verbose
/usr/local/bin/tootctl media remove --days <%= @thinning_days_profiles %>       --verbose --prune-profiles
/usr/local/bin/tootctl media remove --days <%= @thinning_days_headers %>        --verbose --remove-headers

/usr/local/bin/tootctl preview_cards remove --days <%= @thinning_days_pcards %> --verbose
