#!/usr/bin/env bash

set -e

/usr/local/bin/tootctl media remove --verbose --days <%= @thinning_days_media %>
/usr/local/bin/tootctl media remove --verbose --days <%= @thinning_days_profiles %> --prune-profiles
/usr/local/bin/tootctl media remove --verbose --days <%= @thinning_days_headers %> --remove-headers

/usr/local/bin/tootctl preview_cards remove --verbose --days <%= @thinning_days_pcards %>
