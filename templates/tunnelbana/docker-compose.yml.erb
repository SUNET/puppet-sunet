services:
  tunnelbana:
    image: <%= @image %>:<%= @tunnelbana_tag %>
    restart: unless-stopped
    volumes:
      - '<%= @config_dir %>:/app/config:ro'
      - '<%= @keys_dir %>:/app/keys:ro'
      - '<%= @metadata_dir %>:/app/metadata:ro'
    ports:
      - 443:8080
    command: ['/app/config/<%= @config_file %>']
