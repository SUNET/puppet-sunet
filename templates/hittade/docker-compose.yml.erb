---
services:
  db:
    restart: always
    image: postgres:14-alpine
    shm_size: 1024mb
    healthcheck:
      test: ['CMD', 'pg_isready', '-U', 'postgres']
      interval: 30s
      timeout: 60s
      retries: 5
      start_period: 80s
    volumes:
      - ./db:/var/lib/postgresql/data
    environment:
      - 'POSTGRES_HOST_AUTH_METHOD=trust'

  redis:
    restart: always
    image: redis:7-alpine
    healthcheck:
      test: ['CMD', 'redis-cli', 'ping']
      interval: 30s
      timeout: 60s
      retries: 5
      start_period: 80s
    volumes:
      - ./redis:/data

  web:
    image: <%= @image %>:<%= @image_tag %>
    restart: always
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    command: ./docker-entrypoint.sh
    volumes:
      - <%= @config_dir %>/localsettings.py:/app/hittade/localsettings.py
      - <%= @config_dir %>/certificates:/app/certificates
      - <%= @config_dir %>/urls.py:/app/hittade/urls.py
      - <%= @config_dir %>/proxy.xml:/app/proxy.xml
    ports:
      # Localhost-only, for debugging. Host port 8000 is already taken by
      # sunet::invent::receiver, so publish the debug bind on 8001 instead.
      # Public traffic comes in via the nginx-proxy run by
      # sunet::invent::receiver (see networks below), not this port.
      - "127.0.0.1:8001:8000"
    expose:
      - "8000"
    environment:
      # Picked up by the nginx-proxy + acme-companion stack from
      # sunet::invent::receiver, which terminates TLS and routes to us.
      - VIRTUAL_HOST=<%= @hostname %>
      - VIRTUAL_PORT=8000
      - VIRTUAL_PATH=/
      - LETSENCRYPT_HOST=<%= @hostname %>
    networks:
      # default: reach db/redis privately.
      - default
      # receiver_default: the network created by the sunet::invent::receiver
      # compose project (/opt/receiver), where its nginx-proxy lives. This is
      # how nginx-proxy reaches this container. Requires the receiver to be
      # deployed first so the external network exists.
      - receiver_default

networks:
  default:
  receiver_default:
    external: true
