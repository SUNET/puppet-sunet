---
services:
  db:
    restart: always
    image: postgres:18-alpine
    shm_size: 1024mb
    healthcheck:
      test: ['CMD', 'pg_isready', '-U', 'postgres']
      interval: 30s
      timeout: 60s
      retries: 5
      start_period: 80s
    volumes:
      - ./db:/var/lib/postgresql
    environment:
      - 'POSTGRES_HOST_AUTH_METHOD=trust'

  redis:
    restart: always
    image: redis:8-alpine
    healthcheck:
      test: ['CMD', 'redis-cli', 'ping']
      interval: 30s
      timeout: 60s
      retries: 5
      start_period: 80s
    volumes:
      - ./redis:/data

  web:
    image: <%= @image %>:<%= @image_tag %>
    restart: always
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    command: ./docker-entrypoint.sh
    volumes:
      - <%= @config_dir %>/localsettings.py:/app/hittade/localsettings.py
      - <%= @config_dir %>/certificates:/app/certificates
      - <%= @config_dir %>/urls.py:/app/hittade/urls.py
      - <%= @config_dir %>/proxy.xml:/app/proxy.xml
      # Host data from sunet::invent::receiver (rrsync'd into /opt/receiver/hosts),
      # mounted read-only so hittade can read/scan/import it.
      - /opt/receiver/hosts:/hosts:ro
    ports:
      # Localhost-only, for debugging. Host port 8000 is already taken by
      # sunet::invent::receiver, so publish the debug bind on 8001 instead.
      # Caddy reaches web:8000 over receiver_default.
      - "127.0.0.1:8001:8000"
    expose:
      - "8000"
    environment:
      - PRODUCTION=true
    networks:
      # default: reach db/redis privately.
      - default
      # Shared with Invent's Caddy for inbound requests.
      - receiver_default

networks:
  default:
  receiver_default:
    external: true
